# mock: 가짜 데이터로 개발/테스트, korail: 실제 코레일 연동
PROVIDER=mock

# 코레일 멤버십 계정 (PROVIDER=korail 일 때 필요)
KORAIL_ID=
KORAIL_PW=

# 조회 주기(초). 서버 부하/계정 차단 방지를 위해 최소 10초로 제한됨
POLL_INTERVAL_SEC=20

# 웹 UI 접근 토큰 (비워두면 인증 없음 - 외부 공개 서버에서는 반드시 설정)
APP_TOKEN=

# 이 앱 주소 (카카오 메시지의 '앱 열기' 링크)
APP_URL=http://localhost:8000

# ---- 알림: 쓰고 싶은 것만 채우세요. 여러 개 채우면 모두로 보냅니다 ----

# 카카오톡 '나에게 보내기' (README의 '카카오톡 알림 설정' 참고)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/kakao/callback

# Gmail (구글 계정 2단계 인증 + 앱 비밀번호 필요)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL_TO=

# 텔레그램
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
